# COOKIE_DOMAIN=jogamp.org
COOKIE_DYNAMIC_DOMAIN=true
COOKIE_PREFIX=jogamp-anubis-cookie
#COOKIE_SECURE=false
#COOKIE_SAME_SITE=Lax
#COOKIE_PARTITIONED=false
BIND=:8923
#DIFFICULTY=4
METRICS_BIND=:9090
SERVE_ROBOTS_TXT=0
POLICY_FNAME=/etc/anubis/apache2.botPolicies.yaml
TARGET=http://localhost:3001
#SLOG_LEVEL=DEBUG
#SLOG_LEVEL=INFO
SLOG_LEVEL=WARN
